<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; ANTENNA CHECK"
            android:textColor="@color/cyan_500"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick a target and read its live signal. Peak holds the best. Capture A with one antenna, swap, capture B with the next, and it says which is stronger. Keep the phone and target still; change only the antenna between captures. (RSSI is only relative.)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/antScanButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; START SCANNING"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/antTargetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; SELECT TARGET" />

        <TextView
            android:id="@+id/antTargetLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No target selected"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/antSourceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; RADIO: STRONGEST" />

        <TextView
            android:id="@+id/antSourceLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Measuring the strongest radio that hears the target. Pick the rig's radio to test the rig's antenna."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/antRssi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/cyan_500"
            android:textSize="52sp"
            android:textStyle="bold"
            android:text="--" />

        <ProgressBar
            android:id="@+id/antBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/antStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:text="Peak --   ·   Avg --" />

        <TextView
            android:id="@+id/antSources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:text="" />

        <TextView
            android:id="@+id/antCompare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/amber_warning"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/antResetButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="RESET" />

            <Button
                android:id="@+id/antCaptureAButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="CAPTURE A" />

            <Button
                android:id="@+id/antCaptureBButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="CAPTURE B" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
