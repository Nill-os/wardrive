<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; SETTINGS &lt;"
            android:textColor="@color/cyan_500"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; RIG PAIRING"
            android:textColor="@color/cyan_500"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/pairedRigText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/forgetRigButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&gt; FORGET THIS RIG"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/serviceModeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&gt; RIG SERVICE MODE (LOG SERVER)"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Parks the rig on WiFi so you can download its logs from a browser (no SD-card removal). Pauses scanning; tap the rig screen to exit. The rig shows the URL, and it also pops up here."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; UPLOAD CREDENTIALS"
            android:textColor="@color/cyan_500"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/wigleTokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="WiGLE API token (Basic auth value)"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="textPassword"
            android:singleLine="true" />

        <EditText
            android:id="@+id/wdgwarsKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="wdgwars.pl API key"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/showKeysButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&gt; SHOW KEYS" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; PRIVACY: HOME EXCLUSION ZONE"
            android:textColor="@color/cyan_500"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Devices within this radius of home are never logged, exported or uploaded (your home stays private). They still appear briefly in the live tools so fox-hunt and antenna check work at home. Radius 0 disables it. This zone is also pushed to the rig on save."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/homeLatInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Home latitude"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="numberSigned|numberDecimal"
            android:singleLine="true" />

        <EditText
            android:id="@+id/homeLonInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Home longitude"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="numberSigned|numberDecimal"
            android:singleLine="true"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/homeRadiusInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Exclusion radius (meters)"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/useCurrentLocationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&gt; USE CURRENT GPS FIX AS HOME"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; PRIVACY: BLACKLISTS"
            android:textColor="@color/cyan_500"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Any SSID ending in _nomap is always excluded (WiGLE's own opt-out convention), regardless of these lists."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/macBlacklistInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MAC blacklist, comma-separated"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/ssidBlacklistInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SSID/name blacklist, comma-separated"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; GPS QUALITY GATING"
            android:textColor="@color/cyan_500"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pause logging when HDOP (horizontal position quality from real GPS NMEA data) rises above this value - tunnels, urban canyons, or no fix yet. 0 disables this and always logs."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/maxHdopInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Max HDOP, 0 = disabled"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; STORAGE"
            android:textColor="@color/cyan_500"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete logs older than this many days on app start. 0 keeps everything forever."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/retentionDaysInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Retention (days), 0 = forever"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; DRIVING"
            android:textColor="@color/cyan_500"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/spokenMinutesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Spoken update every N minutes, 0 = off"
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:inputType="number"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/spokenTrackerCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:text="Say it out loud when a tracker seems to follow you" />

        <CheckBox
            android:id="@+id/autoUploadCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:text="Upload each run automatically when it stops on WiFi" />

        <CheckBox
            android:id="@+id/tripModeCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:text="Trip mode: upload the rig's data through this phone (Bluetooth)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; MESHTASTIC"
            android:textColor="@color/cyan_500"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log the LoRa mesh nodes your own Meshtastic radio hears during a run and upload them to WDGWars. This app connects to the radio itself, so disconnect the Meshtastic app from the radio while a run is going (a radio takes one Bluetooth connection at a time). Pair the radio with this phone first."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingBottom="6dp" />

        <CheckBox
            android:id="@+id/meshCollectCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:text="Collect Meshtastic nodes during runs" />

        <CheckBox
            android:id="@+id/meshBridgeCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:text="Keep using the Meshtastic app during runs (bridge)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="With the bridge on, the Meshtastic app reaches the radio through this app while a run is going: in the Meshtastic app, open Connections → Network, add 127.0.0.1 manually and connect to it (this also frees the radio's Bluetooth). After the run, switch the Meshtastic app back to the radio over Bluetooth. Any app on this phone could reach the bridge while it's open, so leave it off if you don't need it."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/meshRadioText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:paddingTop="4dp" />

        <Button
            android:id="@+id/meshRadioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&gt; CHOOSE RADIO"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; BACKGROUND"
            android:textColor="@color/cyan_500"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android's battery optimizer can pause or kill scanning when the screen is off or the app is in the background, so a long drive stops logging. Allow unrestricted background usage so a run keeps going with the screen off."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/batteryOptButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&gt; ALLOW BACKGROUND USAGE"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:text="For trips away from home WiFi. While on, the rig sends its logs over Bluetooth and this phone uploads them over its own connection; the rig holds off its own upload so nothing is sent twice. Off = the rig uploads over its own WiFi as usual." />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="&gt; APP THEME" android:textColor="@color/cyan_500"
            android:textSize="14sp" android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="4dp" />

        <Button android:id="@+id/primaryAccentButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Primary accent colour" />
        <Button android:id="@+id/secondaryAccentButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Secondary accent colour" />
        <Button android:id="@+id/resetThemeButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="&gt; RESET THEME" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="&gt; RIG LEDS &amp; SCREEN" android:textColor="@color/cyan_500"
            android:textSize="14sp" android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="4dp" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="12sp"
            android:text="Applied to the rig over Bluetooth and saved on its SD card. The CYD screen keeps its own look; these are just the status LEDs and screen brightness/timeout." />

        <EditText android:id="@+id/rigLedBrightnessInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="LED brightness 0-100" android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary" android:inputType="number" android:singleLine="true" />
        <EditText android:id="@+id/rigScreenBrightnessInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Screen brightness 0-100" android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary" android:inputType="number" android:singleLine="true" />
        <EditText android:id="@+id/rigScreenTimeoutInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Screen timeout seconds, 0 = never" android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary" android:inputType="number" android:singleLine="true" />
        <CheckBox android:id="@+id/rigScreenKeepOnCheck"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:text="Keep the rig screen on while a run is active" />
        <CheckBox android:id="@+id/rigCountFoundCheck"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:text="Counters show found APs / BT / ALL instead of WiGLE / WDGW (this app, the rig screen and the map overlay)" />
        <Button android:id="@+id/rigLedApButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LED colour: AP seen" />
        <Button android:id="@+id/rigLedBleButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LED colour: BLE seen" />
        <Button android:id="@+id/rigLedOkButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LED colour: OK / start / stop" />
        <Button android:id="@+id/rigLedFailButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LED colour: error / fail" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="&gt; RIG NETWORK &amp; DEBUG" android:textColor="@color/cyan_500"
            android:textSize="14sp" android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="4dp" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="12sp"
            android:text="Change the WiFi the rig uploads through, and the service-mode password that protects the log server. Sent to the rig over Bluetooth and saved on its SD card. Leave a field blank to keep what the rig already has. Password fields are cleared after saving." />

        <EditText android:id="@+id/rigWifiSsidInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="WiFi network name (SSID)" android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary" android:inputType="text" android:singleLine="true" />
        <EditText android:id="@+id/rigWifiPassInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="WiFi password" android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary" android:inputType="textPassword" android:singleLine="true" />
        <EditText android:id="@+id/rigBackupSsidInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Backup WiFi name (e.g. phone hotspot)" android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary" android:inputType="text" android:singleLine="true" />
        <EditText android:id="@+id/rigBackupPassInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Backup WiFi password" android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary" android:inputType="textPassword" android:singleLine="true" />
        <EditText android:id="@+id/rigServicePassInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Service-mode password (log server)" android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary" android:inputType="textPassword" android:singleLine="true" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="&gt; DETECTION ALERTS" android:textColor="@color/cyan_500"
            android:textSize="14sp" android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="4dp" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="12sp"
            android:text="Announce (spoken + vibrate on the phone, and a banner + LED flash on the rig) the first time each of these is seen in a run. Sent to the rig too, so alerts work with or without the phone." />
        <CheckBox android:id="@+id/alertFlockCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:text="Flock cameras (ALPR)" />
        <CheckBox android:id="@+id/alertPoliceCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:text="Police body/fleet cameras" />
        <CheckBox android:id="@+id/alertSkimmerCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:text="Possible BLE card skimmers" />
        <CheckBox android:id="@+id/alertFlipperCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:text="Flipper Zero" />
        <CheckBox android:id="@+id/alertDroneCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:text="Drones (Remote ID) - phone only" />
        <CheckBox android:id="@+id/alertMeshCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:text="Meshtastic radios - phone only" />
        <CheckBox android:id="@+id/alertGlassesCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:text="Smart glasses" />
        <CheckBox android:id="@+id/alertActionCamCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:text="Action cameras" />
        <CheckBox android:id="@+id/alertPineappleCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:text="WiFi Pineapple (rogue AP)" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&gt; SAVE"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
