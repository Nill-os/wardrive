<?xml version="1.0" encoding="utf-8"?>
<!-- Sharp rectangular panel with a crisp 1px border, replacing the old
     shadow-only rounded card - "box-in-box" hierarchy per the tactical spec,
     no corner radius anywhere. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke android:width="1dp" android:color="@color/text_secondary" />
</shape>
