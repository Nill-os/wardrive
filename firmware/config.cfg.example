wifi_ssid=YourHomeWifi
wifi_pass=yourpassword
backup_wifi_ssid=YourPhoneHotspot
backup_wifi_pass=yourhotspotpassword
wigle_api_token=BASE64_ENCODED_APINAME_COLON_APITOKEN
wdgwars_api_key=YOUR_64_HEX_CHARACTER_WDGWARS_KEY
min_upload_interval_sec=21600
home_lat=37.774900
home_lon=-122.419400
home_radius_m=150
# Drop any sighting within this many meters of home before it is logged or
# uploaded (the rig's own exclusion zone, like the phone app's). 0 = off.
exclude_radius_m=0
# Status LED brightness on all three boards, 0-100 %.
led_brightness=3
# CYD screen backlight, 0-100 %.
screen_brightness=100
# Blank the CYD screen after this many seconds of no touch. 0 = never off.
screen_timeout_sec=0
# Keep the screen on while a run is active (true), or let it time out anyway (false).
screen_keep_on_scanning=true
# Status-LED colors (hex RRGGBB): AP seen, BLE seen, ok/start/stop, error/fail.
led_color_ap=FF00FF
led_color_ble=00FFFF
led_color_ok=00FF00
led_color_fail=FF0000
# Storage: keep every uploaded log forever until free space drops below
# min_free_mb, then delete the OLDEST uploaded files just until it's back above.
# Un-uploaded data is never deleted. retention_days is an optional age cap
# (0 = off). Set min_free_mb=0 to never delete for space.
retention_days=0
min_free_mb=1024
channel_hop_ms=150
# CYD headline counters: 0 = WIGLE (WiFi) / WDGW (WiFi+BLE), 1 = found APs / BT / ALL.
count_mode=0
# Password for service mode's log web server. Strongly recommended: when set,
# the web page/downloads need this password. Left blank, service mode is open
# to anyone on the same WiFi while it's running - only fine on a trusted network.
service_password=
# Detection alerts on the CYD (a red banner + LED flash the first time each is
# seen in a run). 1 = on, 0 = off. The phone app's alert toggles push these,
# so you normally set them there, but they can live here too.
alert_flock=0
alert_police=0
alert_skimmer=0
alert_flipper=0
alert_glasses=0
alert_actioncam=0
alert_pineapple=0
