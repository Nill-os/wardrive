+package app.organicmaps.wardrive
+
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+
+/**
+ * Organic Maps' whole wardrive integration is a display of the standalone Wardrive Bridge app:
+ * that app owns the rig connection, scanning, logging and settings, and this just reads its live
+ * status (for the map overlay and the Android Auto badge) and asks it to start/stop a run (the
+ * car's record button). Nothing here scans or talks to the rig, so the two apps can't compete.
+ *
+ * Every call is cross-app IPC - keep them off the main thread.
+ */
+object WardriveBridgeClient {
+    const val BRIDGE_PACKAGE = "com.dreknil.wardrivebridge"
+    private val STATUS_URI: Uri = Uri.parse("content://com.dreknil.wardrivebridge.bridge/status")
+    private val BRIDGE_URI: Uri = Uri.parse("content://com.dreknil.wardrivebridge.bridge")
+
+    enum class RigState { DISCONNECTED, CONNECTING, CONNECTED }
+
+    data class Status(
+        val running: Boolean,
+        val paused: Boolean,
+        val wigle: Int,
+        val wdgw: Int,
+        val bt: Int,
+        val cydConnected: Boolean,
+        /** "BLE" or "USB" while the phone is linked to the CYD, blank otherwise. */
+        val cydTransport: String,
+        val rig: RigState,
+        val excluded: Int,
+        /** false = WIGLE / WDGW / BT, true = found view: APS / BT / ALL (one setting in Wardrive Bridge). */
+        val foundMode: Boolean = false,
+    )
+
+    /** Live status, or null when Wardrive Bridge isn't installed, isn't running, or refused. */
+    fun status(context: Context): Status? {
+        val cursor = try {
+            context.contentResolver.query(STATUS_URI, null, null, null, null)
+        } catch (_: Exception) {
+            null
+        } ?: return null
+        cursor.use { c ->
+            if (!c.moveToFirst()) return null
+            fun int(name: String) = c.getInt(c.getColumnIndexOrThrow(name))
+            if (int("service_up") == 0) return null
+            return Status(
+                running = int("running") == 1,
+                paused = int("paused") == 1,
+                wigle = int("wigle"),
+                wdgw = int("wdgw"),
+                bt = int("bt"),
+                cydConnected = int("cyd_connected") == 1,
+                cydTransport = c.getString(c.getColumnIndexOrThrow("cyd_transport")) ?: "",
+                rig = RigState.entries.getOrElse(int("rig_state")) { RigState.DISCONNECTED },
+                excluded = int("excluded"),
+                // Older Wardrive Bridge builds have no count_mode column - treat as the default view.
+                foundMode = c.getColumnIndex("count_mode").let { it >= 0 && c.getInt(it) == 1 },
+            )
+        }
+    }
+
+    /** Starts (true) or stops (false) a run in Wardrive Bridge. Returns false if it couldn't. */
+    fun setRunning(context: Context, run: Boolean): Boolean = try {
+        context.contentResolver.call(BRIDGE_URI, if (run) "start" else "stop", null, null)
+            ?.getBoolean("ok") == true
+    } catch (_: Exception) {
+        false
+    }
+
+    /** Intent that opens Wardrive Bridge, or null if it isn't installed. */
+    fun launchIntent(context: Context): Intent? =
+        context.packageManager.getLaunchIntentForPackage(BRIDGE_PACKAGE)
+}
diff --git a/android/libs/wardrive/src/main/java/app/organicmaps/wardrive/WardriveStatusFormatter.kt b/android/libs/wardrive/src/main/java/app/organicmaps/wardrive/WardriveStatusFormatter.kt
new file mode 100644
index 0000000000..e513e418c6
--- /dev/null
+++ b/android/libs/wardrive/src/main/java/app/organicmaps/wardrive/WardriveStatusFormatter.kt
@@ -0,0 +1,75 @@
+package app.organicmaps.wardrive
+
+import android.text.SpannableStringBuilder
+import android.text.style.ForegroundColorSpan
+
+// Exact colors from the CYD rig's own on-device stat box (cyd_node/src/main.cpp
+// COLOR_CYAN/COLOR_PURPLE/COLOR_GREEN/COLOR_RED), so the overlay reads as the same UI.
+const val COLOR_CYD_CYAN = 0xFF00F0FF.toInt()
+const val COLOR_CYD_PURPLE = 0xFF9D00FF.toInt()
+const val COLOR_CYD_GREEN = 0xFF22C55E.toInt()
+const val COLOR_CYD_RED = 0xFFEF4444.toInt()
+private const val COLOR_DIM = 0xFF9CA3AF.toInt()
+
+/**
+ * Builds the "OFF · WIGLE n · WDGW n · BT n · CYD BLE · Rig ✓" line shown on the main map overlay
+ * and the Android Auto corner badge, from Wardrive Bridge's live status. Always shown, including
+ * while stopped, so a glance answers "is everything linked and running". CYD is the phone's link
+ * to the CYD board (BLE, or USB as the fallback); Rig is the CYD's wired link to the other boards.
+ * [status] null means Wardrive Bridge isn't running (or isn't installed).
+ */
+fun formatStatusLine(status: WardriveBridgeClient.Status?): CharSequence {
+    val builder = SpannableStringBuilder()
+    fun appendColored(text: String, color: Int) {
+        val start = builder.length
+        builder.append(text)
+        builder.setSpan(ForegroundColorSpan(color), start, builder.length, 0)
+    }
+
+    if (status == null) {
+        appendColored("Wardrive Bridge not running", COLOR_DIM)
+        return builder
+    }
+
+    appendColored(
+        when {
+            status.paused -> "PAUSED"
+            status.running -> "ON"
+            else -> "OFF"
+        },
+        if (status.running && !status.paused) COLOR_CYD_GREEN else COLOR_CYD_RED,
+    )
+    builder.append("  ·  ")
+    if (status.foundMode) { // APS / BT / ALL, same order and colors as the CYD's found-device view
+        appendColored("APS ${status.wigle}", COLOR_CYD_CYAN)
+        builder.append("  ·  ")
+        appendColored("BT ${status.bt}", COLOR_CYD_GREEN)
+        builder.append("  ·  ")
+        appendColored("ALL ${status.wdgw}", COLOR_CYD_PURPLE)
+    } else {
+        appendColored("WIGLE ${status.wigle}", COLOR_CYD_CYAN)
+        builder.append("  ·  ")
+        appendColored("WDGW ${status.wdgw}", COLOR_CYD_PURPLE)
+        builder.append("  ·  ")
+        appendColored("BT ${status.bt}", COLOR_CYD_GREEN)
+    }
+    builder.append("  ·  ")
+    appendColored(
+        if (status.cydConnected) "CYD ${status.cydTransport.ifBlank { "✓" }}" else "CYD ✗",
+        if (status.cydConnected) COLOR_CYD_GREEN else COLOR_CYD_RED,
+    )
+    builder.append("  ·  ")
+    appendColored(
+        when (status.rig) {
+            WardriveBridgeClient.RigState.CONNECTED -> "Rig ✓"
+            WardriveBridgeClient.RigState.CONNECTING -> "Rig …"
+            WardriveBridgeClient.RigState.DISCONNECTED -> "Rig ✗"
+        },
+        when (status.rig) {
+            WardriveBridgeClient.RigState.CONNECTED -> COLOR_CYD_GREEN
+            WardriveBridgeClient.RigState.CONNECTING -> COLOR_CYD_PURPLE
+            WardriveBridgeClient.RigState.DISCONNECTED -> COLOR_CYD_RED
+        },
+    )
+    return builder
+}
