+  /** Background-safe: reads Wardrive Bridge's state and redraws the strip if the button changed. */
+  private void refreshWardriveStatus()
+  {
+    final Context context = getCarContext().getApplicationContext();
+    mWardriveExecutor.execute(() -> {
+      final WardriveBridgeClient.Status previous = mWardriveStatus;
+      final WardriveBridgeClient.Status now = WardriveBridgeClient.INSTANCE.status(context);
+      mWardriveStatus = now;
+      final boolean wasRunning = previous != null && previous.getRunning();
+      final boolean isRunning = now != null && now.getRunning();
+      if ((previous == null) != (now == null) || wasRunning != isRunning)
+        mWardriveHandler.post(this::invalidate);
+    });
+  }
